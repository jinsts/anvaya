---
import DiagramFrame from '../learning/DiagramFrame.astro';
import {
  tlbReach,
  traceTlb,
  twoPasses,
} from '../../../labs/computer-architecture-execution/access-time-and-translation/accessTime';
// Two loops over pages 0, 1, 2, … through a cold, fully associative TLB with
// LRU replacement. Results come from the tested model; sizes are illustrative.
const ENTRIES = 4;
const PAGE_BYTES = 4096;
const loops = [3, 5].map((pages) => {
  const sequence = twoPasses(pages);
  const results = traceTlb(sequence, ENTRIES);
  const cells = sequence.map((page, i) => ({ page, result: results[i]! }));
  return {
    pages,
    cells,
    passes: [cells.slice(0, pages), cells.slice(pages)],
    secondPassHits: results.slice(pages).filter((r) => r === 'hit').length,
  };
});
const reachKiB = tlbReach(ENTRIES, PAGE_BYTES) / 1024;
---

<DiagramFrame
  caption={`A cold, fully associative ${ENTRIES}-entry TLB with LRU replacement; each loop reads one address in each page, then repeats. With ${PAGE_BYTES / 1024}\u00a0KiB pages the TLB reaches ${reachKiB}\u00a0KiB. Illustrative sizes; results from the lesson's tested model.`}
>
  <div class="loops">
    {loops.map((loop) => (
      <div
        class="loop"
        role="group"
        aria-label={`${loop.pages} pages, twice: ${loop.cells.map((c) => `page ${c.page} ${c.result}`).join(', ')}`}
      >
        <p class="title">
          <strong>{loop.pages} pages, twice</strong>
          <span>
            second pass: {loop.secondPassHits} of {loop.pages} hit
          </span>
        </p>
        <div class="passes" aria-hidden="true">
          {loop.passes.map((pass, p) => (
            <div class="pass">
              <span class="pass-name">pass {p + 1}</span>
              <ol class="cells">
                {pass.map((cell) => (
                  <li class={cell.result}>
                    <span class="page">
                      <span class="word">page </span>
                      {cell.page}
                    </span>
                    <span class="result">{cell.result}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</DiagramFrame>
<style>
  .loops {
    display: grid;
    gap: var(--space-4);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
  }
  .title span {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .passes {
    display: grid;
    gap: var(--space-1);
  }
  .pass {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
  }
  .pass-name {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .cells {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Lesson prose spaces list items; these are cells, not prose. */
  .loops .cells li {
    margin-top: 0;
  }
  .cells li {
    display: grid;
    gap: 2px;
    padding: var(--space-1);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .cells li.hit {
    border: 2px solid var(--accent);
    background: var(--accent-soft);
  }
  .page {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .result {
    font-size: var(--text-xs);
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .pass {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }
    /* Page numbers alone fit five cells across a phone screen. */
    .word {
      display: none;
    }
  }
  .miss .result {
    color: var(--muted);
  }
</style>
