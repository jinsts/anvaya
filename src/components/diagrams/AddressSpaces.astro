---
import DiagramFrame from '../learning/DiagramFrame.astro';
import {
  RESOURCES,
  type Relation,
} from '../../../labs/operating-systems-runtime-internals/threads/sharing';
// The three resources share.c recorded, drawn as the tested model classifies
// them: once and used by both when shared, once each when copied or separate.
const shown = ['globals and heap', 'stack', 'file descriptors'];
const rows = RESOURCES.filter((r) => shown.includes(r.name));
const panels: {
  relation: Relation;
  title: string;
  members: [string, string];
}[] = [
  {
    relation: 'thread',
    title: 'Two threads in one process',
    members: ['main thread', 'thread T'],
  },
  {
    relation: 'fork',
    title: 'A parent and its forked child',
    members: ['parent', 'child'],
  },
];
const label = (kind: string) =>
  kind === 'copied' ? 'copy' : kind === 'separate' ? 'own' : 'shared';
---

<DiagramFrame caption="What two threads of one process have in common, and what a forked child gets, for the memory and descriptors share.c tested. Boxes that span both columns are one object used by both; boxes in a column belong to one of them. The classification comes from the lesson's tested model, which share.c's recorded output agrees with.">
  <div class="panels">
    {panels.map((panel) => (
      <section
        class="panel"
        aria-label={`${panel.title}: ${rows.map((r) => `${r.name} ${r[panel.relation]}`).join(', ')}`}
      >
        <h4>{panel.title}</h4>
        <div class="grid" aria-hidden="true">
          <span class="member">{panel.members[0]}</span>
          <span class="member">{panel.members[1]}</span>
          {rows.map((row) =>
            row[panel.relation] === 'shared' ? (
              <span class:list={['box', 'both', row.kind]}>
                {row.name} <em>{label('shared')}</em>
              </span>
            ) : (
              <>
                <span class:list={['box', row.kind]}>{row.name}</span>
                <span class:list={['box', row.kind, 'second']}>
                  {row.name} <em>{label(row[panel.relation])}</em>
                </span>
              </>
            ),
          )}
        </div>
        <p class="where">
          {panel.relation === 'thread'
            ? 'One address space and one descriptor table.'
            : 'Two address spaces and two descriptor tables.'}
        </p>
      </section>
    ))}
  </div>
</DiagramFrame>
<style>
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
  .panel {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  h4 {
    margin: 0;
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .member {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }
  .box {
    padding: var(--space-2);
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    text-align: center;
  }
  .box.both {
    grid-column: 1 / -1;
  }
  .box.memory {
    border-color: var(--tone-blue);
    background: var(--tone-blue-soft);
  }
  .box.kernel {
    border-color: var(--tone-violet);
    background: var(--tone-violet-soft);
  }
  .box.second {
    border-style: dashed;
  }
  em {
    display: block;
    color: var(--muted);
    font-style: normal;
    font-weight: 600;
  }
  .where {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }
</style>
