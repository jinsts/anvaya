---
import DiagramFrame from '../learning/DiagramFrame.astro';
import { falseSharing } from '../../../labs/computer-architecture-execution/multicore/models';
import raw from '../../../labs/computer-architecture-execution/multicore/false-sharing.json?raw';
// Layout, coherence traffic from the tested MESI model, and the recorded
// measurement of two threads incrementing their own counters.
const data = JSON.parse(raw);
const median = (layout: string) => {
  const v = data.records
    .filter((r: { layout: string }) => r.layout === layout)
    .map((r: { nsPerIncrement: number }) => r.nsPerIncrement)
    .sort((a: number, b: number) => a - b);
  return { median: v[v.length >> 1] as number, values: v as number[] };
};
const adjacent = median('adjacent');
const padded = median('padded');
const max = Math.max(...adjacent.values, ...padded.values);
const traffic = falseSharing(8);
const fmt = (n: number) => n.toFixed(2);
const layouts = [
  {
    name: 'One line',
    note: 'a at byte 0, b at byte 8',
    lines: [['a', 'b']],
    key: 'adjacent',
    result: adjacent,
    requests: traffic.sharedOwnershipRequests,
  },
  {
    name: 'Padded',
    note: 'a and b 64 bytes apart',
    lines: [['a'], ['b']],
    key: 'padded',
    result: padded,
    requests: traffic.paddedOwnershipRequests,
  },
];
---

<DiagramFrame
  caption={`Two threads, each incrementing only its own counter. Measured: median ns per increment over ${data.records.length / 2} alternating runs of ${(data.records[0].iterations / 1e6).toLocaleString('en')} million increments per thread, ${data.cpu}, ${data.compiler}, -O2, recorded ${data.date.slice(0, 10)}. Ownership requests are from the tested MESI model for eight alternating writes.`}
>
  <div class="sharing">
    {layouts.map((l) => (
      <div
        class="layout"
        role="group"
        aria-label={`${l.name}: ${l.requests} ownership requests in the model; measured median ${fmt(l.result.median)} ns per increment`}
      >
        <p class="title">
          <strong>{l.name}</strong> <span>{l.note}</span>
        </p>
        <div class="lines" aria-hidden="true">
          {l.lines.map((line) => (
            <span class="line">
              {line.map((name) => (
                <span class={`counter c-${name}`}>
                  {name} · core {name === 'a' ? 'A' : 'B'}
                </span>
              ))}
              <span class="rest">rest of the 64-byte line</span>
            </span>
          ))}
        </div>
        <p class="stat">
          <span>Ownership requests for 8 alternating writes</span>
          <strong>{l.requests}</strong>
        </p>
        <div class="bar" aria-hidden="true">
          <span style={`width: ${(l.result.median / max) * 100}%`} />
          <strong>{fmt(l.result.median)} ns per increment</strong>
        </div>
      </div>
    ))}
  </div>
</DiagramFrame>
<style>
  .sharing {
    display: grid;
    gap: var(--space-4);
  }
  .layout {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }
  .title span {
    color: var(--muted);
  }
  .lines {
    display: grid;
    gap: var(--space-1);
  }
  .line {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .counter {
    flex: 0 0 auto;
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .c-a {
    background: var(--tone-blue-soft);
    box-shadow: inset 0 -3px 0 var(--chart-1);
  }
  .c-b {
    background: var(--tone-amber-soft);
    box-shadow: inset 0 -3px 0 var(--chart-2);
  }
  .rest {
    flex: 1;
    align-self: center;
    color: var(--muted);
    font-size: var(--text-xs);
    text-align: center;
  }
  .stat {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }
  .stat span {
    color: var(--muted);
  }
  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    font-size: var(--text-xs);
  }
  .bar span {
    height: 12px;
    border-radius: 0 4px 4px 0;
    background: var(--chart-1);
  }
  .bar strong {
    font-family: var(--font-mono);
  }
</style>
