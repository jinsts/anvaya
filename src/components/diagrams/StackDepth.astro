---
import DiagramFrame from '../learning/DiagramFrame.astro';
import { parseListing } from '../../../labs/computer-architecture-execution/reading-assembly/x86';
import {
  stackSteps,
  trackStack,
} from '../../../labs/computer-architecture-execution/call-frames/stackPointer';
import scaleO0 from '../../../labs/computer-architecture-execution/reading-assembly/scale-O0.txt?raw';
import scaleO2 from '../../../labs/computer-architecture-execution/reading-assembly/scale-O2.txt?raw';
// Depth below the entry rsp after each stack instruction of GCC's scale_sum,
// computed by the tested model from the committed listings.
const panels = [
  { label: '-O0', text: scaleO0 },
  { label: '-O2', text: scaleO2 },
].map(({ label, text }) => {
  const steps = stackSteps(parseListing(text));
  const depths = trackStack(steps.map((s) => s.event));
  return {
    label,
    rows: steps.map((step, i) => ({ ...step, depth: depths[i]! })),
  };
});
const deepest = Math.max(...panels.flatMap((p) => p.rows.map((r) => r.depth)));
---

<DiagramFrame caption="Bytes below rsp's value at entry, after each instruction of GCC 15.2's scale_sum that moves rsp. At entry rsp is 8 bytes past a multiple of 16, so a call is aligned when the depth minus 8 is a multiple of 16. Computed by the lesson's tested model from the committed listings.">
  <div class="panels">
    {panels.map((panel) => (
      <div
        class="panel"
        role="group"
        aria-label={`scale_sum ${panel.label}: ${panel.rows.map((r) => `${r.text}, depth ${r.depth}`).join('; ')}`}
      >
        <p class="title">
          <strong>scale_sum {panel.label}</strong>
          <span>depth in bytes</span>
        </p>
        <ol class="rows" aria-hidden="true">
          {panel.rows.map((row) => (
            <li class:list={{ call: row.event === 'call' }}>
              <code>{row.text}</code>
              <span class="track">
                <span
                  class="bar"
                  style={`width: ${(row.depth / deepest) * 100}%`}
                />
              </span>
              <span class="depth">{row.depth}</span>
              {row.event === 'call' && (
                <span class="note">
                  aligned: {row.depth} − 8 = {row.depth - 8}, a multiple of 16
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</DiagramFrame>
<style>
  .panels {
    display: grid;
    gap: var(--space-4);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
  }
  .title span {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .rows {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Lesson prose spaces list items; these are rows of a chart. */
  .panel .rows li {
    margin-top: 0;
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr) 2rem;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding: 2px var(--space-1);
    border-radius: var(--radius-sm);
  }
  .rows li.call {
    outline: 2px solid var(--accent);
    background: var(--accent-soft);
  }
  code {
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-xs);
    overflow-wrap: anywhere;
  }
  .track {
    height: 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--subtle);
  }
  .bar {
    display: block;
    height: 100%;
    border-radius: var(--radius-sm);
    background: var(--chart-1);
  }
  .depth {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .note {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: var(--text-xs);
  }
</style>
