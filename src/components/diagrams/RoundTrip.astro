---
import DiagramFrame from '../learning/DiagramFrame.astro';
import { ROUND_TRIP } from '../../../labs/operating-systems-runtime-internals/context-switches/switches';
// One ping-pong round trip from the tested model, with its two switches.
const switches = ROUND_TRIP.filter((s) => s.switches).length;
---

<DiagramFrame
  caption={`One round trip of the ping-pong between task A and task B on one CPU, from the tested model: each blocking read hands the CPU to the other task, so a round trip makes ${switches === 2 ? 'two' : switches} context switches on top of two writes and two reads.`}
>
  <ol class="trip">
    {ROUND_TRIP.map((s) => (
      <li class={`who-${s.who}`}>
        <span class="who">{s.who}</span>
        <span class="step">{s.step}</span>
        {s.switches && (
          <span class="switch">
            context switch to {s.who === 'A' ? 'B' : 'A'}
          </span>
        )}
      </li>
    ))}
  </ol>
</DiagramFrame>
<style>
  ol.trip {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trip li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }
  .trip li.who-B {
    margin-left: var(--space-5);
  }
  .who {
    display: grid;
    align-self: start;
    min-height: 1.9rem;
    place-items: center;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
  .who-A .who {
    background: var(--tone-blue-soft);
  }
  .who-B .who {
    background: var(--tone-amber-soft);
  }
  .step {
    padding: var(--space-1) 0;
  }
  .switch {
    grid-column: 2;
    padding: var(--space-1) var(--space-2);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
  }
</style>
