---
import DiagramFrame from '../learning/DiagramFrame.astro';
import { sumTrace } from '../../../labs/computer-architecture-execution/simd/lanes';
// The same eight binary32 values summed in source order and in four lanes,
// with every intermediate value from the tested model.
const values = [2 ** 24, 1, 1, 1, 1, 1, 1, 1];
const trace = sumTrace(values);
const n = (x: number) => x.toLocaleString('en');
const exact = values.reduce((a, b) => a + b, 0);
---

<DiagramFrame
  caption={`Summing 2²⁴ and seven ones in binary32. In source order each 1 is lost to rounding, as in the floating-point lesson. In four lanes the ones accumulate in lanes 1–3 before meeting the large value. Neither result is the exact ${n(exact)}, and they differ from each other, which is why GCC vectorizes a float sum only when told the order does not matter.`}
>
  <div class="sums">
    <div
      class="order"
      role="group"
      aria-label={`In source order: ${trace.inOrder.map(n).join(', ')}`}
    >
      <p class="title">
        <strong>Source order</strong>{' '}
        <span>-O3 without reassociation: addss</span>
      </p>
      <ol aria-hidden="true">
        {values.map((v, i) => (
          <li
            class:list={{
              lost: i > 0 && trace.inOrder[i] === trace.inOrder[i - 1],
            }}
          >
            <span>+ {n(v)}</span>
            <strong>{n(trace.inOrder[i]!)}</strong>
          </li>
        ))}
      </ol>
      <p class="result">
        Result <strong>{n(trace.inOrder.at(-1)!)}</strong>
      </p>
    </div>
    <div
      class="order"
      role="group"
      aria-label={`In four lanes: lanes ${trace.lanes.map(n).join(', ')}; pairs ${trace.pairs.map(n).join(' and ')}; total ${n(trace.total)}`}
    >
      <p class="title">
        <strong>Four lanes</strong> <span>-O3 -fassociative-math: addps</span>
      </p>
      <ol class="lanes" aria-hidden="true">
        {trace.lanes.map((lane, l) => (
          <li>
            <span>
              lane {l}: elements {l}, {l + 4}
            </span>
            <strong>{n(lane)}</strong>
          </li>
        ))}
      </ol>
      <p class="combine">
        (lane 0 + lane 2) = {n(trace.pairs[0]!)} · (lane 1 + lane 3) ={' '}
        {n(trace.pairs[1]!)}
      </p>
      <p class="result">
        Result <strong>{n(trace.total)}</strong>
      </p>
    </div>
  </div>
</DiagramFrame>
<style>
  .sums {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
  }
  .order {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .title,
  .combine,
  .result {
    margin: 0;
    font-size: var(--text-sm);
  }
  .title {
    display: grid;
  }
  .title span,
  .combine {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .combine {
    font-family: var(--font-mono);
  }
  ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sums ol li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0;
    padding: 2px var(--space-2);
    border-left: 3px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .sums ol li.lost {
    border-left-color: var(--error);
    background: var(--error-soft);
  }
  .sums ol.lanes li {
    border-left-color: var(--chart-1);
    background: var(--tone-blue-soft);
  }
</style>
