---
import DiagramFrame from '../learning/DiagramFrame.astro';
import { amdahlTimes } from '../../../labs/computer-architecture-execution/architecture-and-performance/example';
// The lesson's illustrative inputs: a quarter of baseline time stays serial and
// the rest becomes four times faster. Every other number comes from the tested
// model, so the bars, the caption and the lesson's example cannot disagree.
const SERIAL = 0.25;
const SPEEDUP = 4;
const times = amdahlTimes(SERIAL, SPEEDUP);
const percent = (fraction: number) => `${fraction * 100}%`;
---

<DiagramFrame
  caption={`For fixed work with no added overhead, making ${percent(times.improvable)} of baseline time ${SPEEDUP}× faster gives 1 / ${times.total} ≈ ${times.speedup.toFixed(3)}× overall speedup.`}
>
  <p>
    <strong>Baseline time: 1</strong>
  </p>
  <div
    class="bar"
    role="img"
    aria-label={`Baseline: serial ${times.serial} followed by improvable ${times.improvable}`}
  >
    <span class="serial" style={`width: ${percent(times.serial)}`}>
      {times.serial}
    </span>
    <span class="work" style={`width: ${percent(times.improvable)}`}>
      {times.improvable}
    </span>
  </div>
  <p>
    <strong>Improved time: {times.total}</strong>
  </p>
  <div
    class="bar"
    role="img"
    aria-label={`Improved: serial ${times.serial} followed by improved ${times.improved}; the rest of baseline time is saved`}
  >
    <span class="serial" style={`width: ${percent(times.serial)}`}>
      {times.serial}
    </span>
    <span class="work" style={`width: ${percent(times.improved)}`}>
      {times.improved}
    </span>
  </div>
  <p>
    First segment: unchanged serial work. Second segment: work eligible for
    improvement. The empty remainder is saved time, using the same scale.
  </p>
</DiagramFrame>
<style>
  .bar {
    display: flex;
    min-height: var(--space-12);
    border: 1px solid var(--border-strong);
    background: var(--subtle);
    border-radius: var(--radius);
  }
  .bar span {
    display: grid;
    place-items: center;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text);
  }
  .serial {
    background: var(--accent-soft);
    border-right: 2px solid var(--border-strong);
  }
  .work {
    border: 1px dashed var(--border-strong);
  }
  p {
    line-height: var(--leading);
  }
</style>
