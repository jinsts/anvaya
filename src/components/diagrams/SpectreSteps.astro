---
import DiagramFrame from '../learning/DiagramFrame.astro';
// A conceptual outline of the Spectre bounds-check pattern, after the
// original paper. It shows the mechanism only; no attack code.
const LINES = 8;
const steps = [
  {
    title: 'Train',
    text: 'Many calls with valid indexes teach the predictor that the bounds check passes.',
    cache: [] as number[],
    probe: false,
  },
  {
    title: 'Mispredict',
    text: 'An out-of-bounds index arrives. Before the check resolves, the core speculatively reads a byte it should not.',
    cache: [],
    probe: false,
  },
  {
    title: 'Leave a trace',
    text: 'Still speculating, it loads from a probe array at an address chosen by that byte, bringing one line into the cache.',
    cache: [5],
    probe: false,
  },
  {
    title: 'Roll back',
    text: 'The check resolves as failed. Registers and memory are restored, so no result is visible, but the cached line stays.',
    cache: [5],
    probe: false,
  },
  {
    title: 'Measure',
    text: 'Timing a read of each probe line finds the one fast, cached line, and its position reveals the byte.',
    cache: [5],
    probe: true,
  },
];
---

<DiagramFrame caption="Spectre's bounds-check variant, conceptually. Speculative work is discarded architecturally, but its effect on the cache is not, and timing can observe the cache. The row of boxes is a probe array's cache lines; the highlighted line is the one the speculative load brought in.">
  <ol class="spectre">
    {steps.map((step, i) => (
      <li>
        <p class="title">
          <span class="number">{i + 1}</span>
          <strong>{step.title}</strong>
        </p>
        <p class="text">{step.text}</p>
        <span
          class="lines"
          role="img"
          aria-label={
            step.cache.length
              ? `Probe line ${step.cache[0]} is cached${step.probe ? ' and reads fast' : ''}`
              : 'No probe line is cached'
          }
        >
          {Array.from({ length: LINES }, (_, line) => (
            <span
              class:list={[
                'line',
                {
                  cached: step.cache.includes(line),
                  fast: step.probe && step.cache.includes(line),
                },
              ]}
            >
              {step.probe
                ? step.cache.includes(line)
                  ? 'fast'
                  : 'slow'
                : step.cache.includes(line)
                  ? 'in cache'
                  : ''}
            </span>
          ))}
        </span>
      </li>
    ))}
  </ol>
</DiagramFrame>
<style>
  .spectre {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .spectre > li {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    align-items: center;
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .diagram-frame .spectre > li + li {
    margin-top: 0;
  }
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }
  .number {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .text {
    grid-column: 1;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: var(--leading);
  }
  .lines {
    grid-column: 2;
    grid-row: 1 / 3;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 2px;
  }
  .line {
    display: grid;
    place-items: center;
    min-height: 2rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: var(--surface);
    color: var(--muted);
    font-size: var(--text-xs);
    text-align: center;
  }
  .line.cached {
    border: 2px solid var(--chart-2);
    background: var(--tone-amber-soft);
    color: var(--text);
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .spectre > li {
      grid-template-columns: 1fr;
    }
    .lines {
      grid-column: 1;
      grid-row: auto;
    }
    .line {
      min-height: 2.5rem;
      font-size: var(--text-xs);
      writing-mode: vertical-rl;
    }
  }
</style>
