---
import DiagramFrame from '../learning/DiagramFrame.astro';
import { transferTimeline } from '../../../labs/computer-architecture-execution/polling-interrupts-and-dma/notification';
// What the CPU and a DMA engine do in each time unit while eight words move to
// a device. Illustrative units from the tested model, not a measurement.
const WORDS = 8;
const label = {
  setup: 'set up',
  copy: 'copy',
  free: 'other work',
  interrupt: 'interrupt',
  idle: '',
} as const;
const rows = (['pio', 'dma'] as const).map((mechanism) => {
  const t = transferTimeline(WORDS, mechanism);
  return {
    mechanism,
    name: mechanism === 'pio' ? 'Programmed I/O' : 'DMA',
    lanes: [
      { who: 'CPU', slots: t.cpu },
      ...(mechanism === 'dma' ? [{ who: 'DMA engine', slots: t.engine }] : []),
    ],
    busy: t.cpuBusy,
    units: t.cpu.length,
  };
});
// One time scale for every lane, so a unit is the same width in each row.
const columns = Math.max(...rows.map((row) => row.units));
---

<DiagramFrame
  caption={`Moving ${WORDS} words to a device, one time unit per word. With programmed I/O the CPU copies every word itself; with DMA it programs the engine, does other work while the engine copies, and handles one completion interrupt. Illustrative units from the lesson's tested model, not a measurement.`}
>
  <div class="transfers">
    {rows.map((row) => (
      <div
        class="transfer"
        role="group"
        aria-label={`${row.name}: the CPU is busy for ${row.busy} of ${row.units} units`}
      >
        <p class="title">
          <strong>{row.name}</strong>
          <span>
            CPU busy {row.busy} of {row.units} units
          </span>
        </p>
        {row.lanes.map((lane) => (
          <div class="lane" aria-hidden="true">
            <span class="who">{lane.who}</span>
            <ol
              class="slots"
              style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr))`}
            >
              {lane.slots.map((slot) => (
                <li class={slot} title={label[slot]}>
                  {slot === 'copy'
                    ? 'c'
                    : slot === 'setup'
                      ? 's'
                      : slot === 'interrupt'
                        ? 'i'
                        : ''}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    ))}
    <p class="key" aria-hidden="true">
      <span>
        <i class="setup">s</i> set up
      </span>
      <span>
        <i class="copy">c</i> copy one word
      </span>
      <span>
        <i class="interrupt">i</i> completion interrupt
      </span>
      <span>
        <i class="free"></i> CPU free for other work
      </span>
    </p>
  </div>
</DiagramFrame>
<style>
  .transfers {
    display: grid;
    gap: var(--space-4);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }
  .title span {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .lane {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .who {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .slots {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Lesson prose spaces list items; these are time slots. */
  .transfers .slots li {
    margin-top: 0;
  }
  .slots li,
  .key i {
    display: grid;
    place-items: center;
    min-height: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-style: normal;
  }
  .copy,
  .setup,
  .interrupt {
    background: var(--accent-soft);
    border-color: var(--accent) !important;
    font-weight: 600;
  }
  .free {
    background: var(--subtle);
    border-style: dashed !important;
  }
  .idle {
    border-color: transparent !important;
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .key span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .key i {
    width: 1.5rem;
  }
</style>
